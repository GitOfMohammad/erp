# Copy to .env on the production host. Replace every placeholder; never commit .env.
ENV_NODE=production
PORT=3000
API_PREFIX=/api/v1

DB_HOST=db.internal.example
DB_PORT=3306
DB_NAME=erp_production
DB_USER=erp_app
DB_PASS=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# Generate two different values with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_ACCESS_SECRET
SECRET_KEY_EXPIRE_TIME=15m
REFRESH_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_REFRESH_SECRET
REFRESH_KEY_EXPIRE_TIME=7d

SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
CORS_ORIGIN=https://erp.example.com
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5
